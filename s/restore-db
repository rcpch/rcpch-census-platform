# ---- 1. Resolve 'latest' to an actual tag ----
VERSION="${1:-latest}"

if [ "$VERSION" = "latest" ]; then
  echo "Resolving latest release version..."
  # This gets the 'tag_name' from the latest release
  VERSION=$(curl -s "https://api.github.com/repos/${GITHUB_REPO}/releases/latest" | jq -r '.tag_name')
fi

if [ "$VERSION" == "null" ] || [ -z "$VERSION" ]; then
  echo "ERROR: Could not resolve version. Check GITHUB_REPO or connectivity."
  exit 1
fi

echo "Using version: ${VERSION}"

# ---- 2. Download Multipart Parts ----
# Naming convention: rcpch-census-v1.1.1.dump.part-aa
DUMP_BASE="rcpch-census-${VERSION}.dump"
WORK_DIR="$(mktemp -d)"
cd "$WORK_DIR"

echo "Downloading parts for ${DUMP_BASE}..."

for char in a b c d e f g h i j; do
    PART="part-a${char}"
    # Construct the exact filename based on the version
    FILE_NAME="${DUMP_BASE}.${PART}"
    URL="https://github.com/${GITHUB_REPO}/releases/download/${VERSION}/${FILE_NAME}"
    
    echo "Attempting to fetch ${PART}..."
    # -f ensures we don't save a 404 page as a file
    if curl -sL -f -O "$URL"; then
        echo "✓ Downloaded ${FILE_NAME}"
    else
        echo "Finished downloading parts (or reached end)."
        break
    fi
done

# ---- 3. Reassemble ----
if ls ${DUMP_BASE}.part-* >/dev/null 2>&1; then
    echo "Reassembling multipart dump..."
    cat ${DUMP_BASE}.part-* > "${DUMP_BASE}"
else
    echo "ERROR: No parts were downloaded. Check if the tag ${VERSION} and filenames match."
    exit 1
fi

# Now pg_restore can use ${DUMP_BASE}