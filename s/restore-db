#!/bin/bash
# Using bash explicitly to support pipefail
set -euo pipefail

GITHUB_REPO="rcpch/rcpch-census-platform"
echo "=========================================="
echo "RCPCH Census – Manual Database Restore"
echo "=========================================="

# ---- Hard safety guard ----
: "${CONFIRM_RESTORE:?You must set CONFIRM_RESTORE=true}"
[ "$CONFIRM_RESTORE" = "true" ] || { echo "Aborting."; exit 1; }

# ---- Required env (Ensure these are passed in your 'exec' command) ----
: "${POSTGRES_DB_HOST:?Required}"
: "${POSTGRES_DB:?Required}"
: "${CENSUS_RESTORE_USER:?Required}"
: "${CENSUS_RESTORE_USER_PASSWORD:?Required}"

VERSION="${1:-latest}"

# 1. Resolve Version
if [ "$VERSION" = "latest" ]; then
  echo "Resolving latest release version..."
  VERSION=$(curl -s "https://api.github.com/repos/${GITHUB_REPO}/releases/latest" | jq -r '.tag_name')
fi
echo "Targeting version: ${VERSION}"

# 2. Setup Workspace
DUMP_BASE="rcpch-census-${VERSION}.dump"
WORK_DIR="$(mktemp -d)"
cd "$WORK_DIR"

# 3. Download Multipart Parts
for char in a b c d e f g h; do
    PART="part-a${char}"
    FILE_NAME="${DUMP_BASE}.${PART}"
    URL="https://github.com/${GITHUB_REPO}/releases/download/${VERSION}/${FILE_NAME}"
    
    if curl -sL -f -O "$URL"; then
        echo "✓ Downloaded ${FILE_NAME}"
    else
        break
    fi
done

# 4. Reassemble and Validate
echo "Reassembling multipart dump..."
cat ${DUMP_BASE}.part-* > "${DUMP_BASE}"
if [ ! -s "${DUMP_BASE}" ]; then
    echo "ERROR: Reassembly failed."
    exit 1
fi
echo "✓ Reassembly successful. Size: $(du -sh "${DUMP_BASE}" | cut -f1)"

# 5. Execute pg_restore
echo "Starting pg_restore... (This may take a while)"
export PGPASSWORD="$CENSUS_RESTORE_USER_PASSWORD"

echo "Wiping existing 'public' schema to resolve ownership conflicts..."
export PGPASSWORD="$CENSUS_RESTORE_USER_PASSWORD"

psql --host="$POSTGRES_DB_HOST" --username="$CENSUS_RESTORE_USER" --dbname="$POSTGRES_DB" <<EOF
-- Drop everything
DROP SCHEMA IF EXISTS public CASCADE;
-- Recreate blank
CREATE SCHEMA public;
-- Restore standard permissions
GRANT ALL ON SCHEMA public TO public;
GRANT ALL ON SCHEMA public TO "$CENSUS_RESTORE_USER";
-- Optional: if the web app uses a different user, grant them access too
GRANT ALL ON SCHEMA public TO "rcpchCensusUser"; 
EOF

echo "✓ Schema wiped. Starting fresh restore..."

# We use '|| true' on pg_restore because it often exits with warnings 
# about 'owner' or 'privileges' that aren't actual failures
pg_restore \
  --host="$POSTGRES_DB_HOST" \
  --username="$CENSUS_RESTORE_USER" \
  --dbname="$POSTGRES_DB" \
  --role="rcpchCensusUser" \
  --no-owner --no-acl --clean --if-exists \
  -v "${DUMP_BASE}"

# 6. Final Verification
echo "Verifying Database Content..."
psql --host="$POSTGRES_DB_HOST" --username="$CENSUS_RESTORE_USER" --dbname="$POSTGRES_DB" -c "SELECT count(*) as table_count FROM information_schema.tables WHERE table_schema = 'public';"

echo "Reassigning ownership to rcpchCensusUser for application access..."
psql --host="$POSTGRES_DB_HOST" --username="$CENSUS_RESTORE_USER" --dbname="$POSTGRES_DB" \
  -c "REASSIGN OWNED BY \"$CENSUS_RESTORE_USER\" TO \"rcpchCensusUser\";"

echo "=========================================="
echo "  RESTORE COMPLETE  "
echo "=========================================="

# Cleanup
rm -rf "$WORK_DIR"