# ---- Download via Curl (No GH Token needed for public repos) ----
cd "$WORK_DIR"

echo "Fetching asset list for version: ${VERSION}..."
# Get the download URLs for all assets in this release
ASSETS=$(curl -s "https://api.github.com/repos/${GITHUB_REPO}/releases/tags/${VERSION}" \
  | jq -r '.assets[].browser_download_url' | grep "${DUMP_FILE}")

if [ -z "$ASSETS" ]; then
  echo "ERROR: No assets found matching ${DUMP_FILE} for version ${VERSION}"
  exit 1
fi

for URL in $ASSETS; do
  echo "Downloading $(basename "$URL")..."
  curl -L -O "$URL"
done

# ---- Reassemble if split ----
# Use the same logic you had before, it works great once files are local
if ls ${DUMP_FILE}.part-* >/dev/null 2>&1; then
  echo "Reassembling multipart dump..."
  cat ${DUMP_FILE}.part-* > "$DUMP_FILE"
fi

if [ ! -s "$DUMP_FILE" ]; then
  echo "ERROR: Final reassembled dump file is missing or empty"
  exit 1
fi