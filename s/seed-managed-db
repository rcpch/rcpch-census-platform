#!/bin/bash
set -e

echo "=========================================="
echo "RCPCH Census - Database Seeder"
echo "=========================================="

# 1. Load local .env if it exists (Skip in CI/Cloud)
if [ -f .env ] && [ -z "$KUBERNETES_SERVICE_HOST" ]; then
    echo "Loading variables from .env..."
    export $(grep -v '^#' .env | xargs)
fi

# 2. Variable Validation
: "${POSTGRES_DB_HOST:?Environment variable POSTGRES_DB_HOST is required}"
: "${POSTGRES_USER:?Environment variable POSTGRES_USER is required}"

DB_PASS=$POSTGRES_PASSWORD

# 3. Smart Azure Token Logic
if [[ "$POSTGRES_DB_HOST" == *"postgres.database.azure.com"* ]]; then
    echo "Azure host detected. Determining Auth Method..."

    # Method A: Inside Azure Container App (Managed Identity Endpoint)
    if [ -n "$IDENTITY_ENDPOINT" ] || [ -n "$MSI_ENDPOINT" ]; then
        echo "Detected Azure Environment. Fetching token via Managed Identity Endpoint..."
        # IDENTITY_ENDPOINT is provided by the ACA runtime
        DB_PASS=$(curl -s "$IDENTITY_ENDPOINT?api-version=2019-08-01&resource=https://ossrdbms-aad.database.windows.net" -H "X-IDENTITY-HEADER: $IDENTITY_HEADER" | jq -r '.access_token')

    # Method B: Local or GitHub Runner (using az CLI)
    elif command -v az &> /dev/null; then
        echo "Detected CLI environment. Fetching token via az CLI..."
        # If not logged in and not in CI, try login
        if ! az account show &> /dev/null && [ -z "$GITHUB_ACTIONS" ]; then
            az login
        fi
        DB_PASS=$(az account get-access-token --resource-type oss-rdbms --query 'accessToken' --output tsv)
    else
        echo "Error: Azure Host detected but no authentication method (az CLI or Managed Identity) found."
        exit 1
    fi
    echo "✓ Token generated successfully"
fi

# 4. Global PG variables
export PGPASSWORD="$DB_PASS"
export PGSSLMODE="require"

# 5. GitHub CLI Auth check
if [ -n "$GITHUB_ACTIONS" ]; then
    echo "Running in GitHub Actions. Using provided GITHUB_TOKEN..."
    export GH_TOKEN="${GITHUB_TOKEN:-$GH_TOKEN}"
elif [ -z "$GH_TOKEN" ] && ! gh auth status &> /dev/null; then
    echo "Warning: GitHub CLI not authenticated. gh release download may fail."
fi

# 6. Version Resolution
VERSION=${1:-"latest"}
if [ "$VERSION" = "latest" ]; then
    VERSION=$(gh api repos/rcpch/rcpch-census-platform/releases --jq '[.[] | select(.draft==false and .prerelease==false)] | sort_by(.published_at) | reverse | .[0].tag_name')
fi

# 7. Workspace and Restore
DUMP_FILE="rcpch-census-${VERSION}.dump"
WORK_DIR="./tmp_seed_$(date +%s)"
mkdir -p "$WORK_DIR" && cd "$WORK_DIR"

echo "Downloading release $VERSION..."
gh release download "$VERSION" -p "${DUMP_FILE}*" -R rcpch/rcpch-census-platform

if ls ${DUMP_FILE}.part-* 1> /dev/null 2>&1; then
    cat ${DUMP_FILE}.part-* > "$DUMP_FILE"
fi

CONN="host=$POSTGRES_DB_HOST port=${POSTGRES_DB_PORT:-5432} user=$POSTGRES_USER dbname=${POSTGRES_DB:-postgres} sslmode=require"

echo "Restoring database..."
pg_restore --dbname="$CONN" --no-owner --no-acl --clean --if-exists -v "$DUMP_FILE"

cd ..
rm -rf "$WORK_DIR"
echo "✓ Database seeding complete!"