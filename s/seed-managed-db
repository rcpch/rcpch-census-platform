#!/bin/bash
set -euo pipefail

echo "=========================================="
echo "RCPCH Census – Database Restore"
echo "=========================================="

# ---- Safety guard ----
: "${CONFIRM_RESTORE:?Set CONFIRM_RESTORE=true to proceed}"
[ "$CONFIRM_RESTORE" = "true" ] || {
  echo "CONFIRM_RESTORE is not 'true'. Aborting."
  exit 1
}

# ---- Required vars ----
: "${POSTGRES_DB_HOST:?Required}"
: "${POSTGRES_DB:?Required}"
: "${CENSUS_RESTORE_USER:?Required}"
: "${CENSUS_RESTORE_USER_PASSWORD:?Required}"

# ---- Postgres env ----
export PGPASSWORD="$CENSUS_RESTORE_USER_PASSWORD"
export PGSSLMODE=require

# ---- GitHub auth ----
if [ -n "${GITHUB_ACTIONS:-}" ]; then
  export GH_TOKEN="${GITHUB_TOKEN:-$GH_TOKEN}"
fi

# ---- Version resolution ----
VERSION=${1:-latest}
if [ "$VERSION" = "latest" ]; then
  VERSION=$(gh api repos/rcpch/rcpch-census-platform/releases \
    --jq '[.[] | select(.draft==false and .prerelease==false)]
           | sort_by(.published_at)
           | reverse
           | .[0].tag_name')
fi

DUMP_FILE="rcpch-census-${VERSION}.dump"
WORK_DIR="$(mktemp -d)"

echo "Using release: $VERSION"
cd "$WORK_DIR"

# ---- Download dump ----
gh release download "$VERSION" \
  -p "${DUMP_FILE}*" \
  -R rcpch/rcpch-census-platform

# ---- Assemble parts ----
if ls ${DUMP_FILE}.part-* >/dev/null 2>&1; then
  echo "Assembling dump parts..."
  cat ${DUMP_FILE}.part-* > "$DUMP_FILE"
fi

# ---- Restore ----
echo "Restoring database..."
pg_restore \
  --host="$POSTGRES_DB_HOST" \
  --port="${POSTGRES_DB_PORT:-5432}" \
  --username="$CENSUS_RESTORE_USER" \
  --dbname="$POSTGRES_DB" \
  --no-owner \
  --no-acl \
  --clean \
  --if-exists \
  -v \
  "$DUMP_FILE"

cd /
rm -rf "$WORK_DIR"

echo "✓ Database restore complete"
